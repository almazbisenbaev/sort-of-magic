{
  "firewallEnabled": true,
  "rules": [
    {
      "name": "Limit AI analysis requests",
      "description": "Allow five AI analysis requests per minute per IP. Local CSV cleanup is unaffected.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/api/repairs" },
            { "type": "method", "op": "eq", "value": "POST" }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 60,
            "limit": 5,
            "keys": ["ip"],
            "action": "rate_limit"
          }
        }
      }
    }
  ]
}
